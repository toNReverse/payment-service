# Copy to .env (never committed) to run the service outside Docker against the compose databases:
#   docker compose up -d postgres redis
#   set -a; source .env; set +a; ./gradlew run
# docker compose reads only STRIPE_SECRET_KEY from .env; it sets the database and Redis URLs itself.

PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/payments
DATABASE_USER=payments
DATABASE_PASSWORD=payments
REDIS_URL=redis://localhost:6379

# Stripe, test mode only: https://dashboard.stripe.com/test/apikeys
# Without it the service uses a fake gateway. Live keys (sk_live_...) are refused at startup.
# STRIPE_SECRET_KEY=sk_test_...

# Where Stripe sends the customer after paying or cancelling. {ORDER_ID} is replaced with the order id.
# Default: this service's own order page, http://localhost:8080/orders/{ORDER_ID}
# CHECKOUT_SUCCESS_URL=https://shop.example/grazie?order={ORDER_ID}
# CHECKOUT_CANCEL_URL=https://shop.example/carrello
