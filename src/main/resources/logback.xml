<configuration>
    <!-- Plain text for now; Milestone 8 switches this to structured JSON with the order id in every line. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <!-- jOOQ logs an ASCII-art logo and a "tip of the day" at startup on this logger. -->
    <logger name="org.jooq.Constants" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
